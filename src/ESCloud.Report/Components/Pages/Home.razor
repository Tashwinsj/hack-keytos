@page "/"
@inject ReportSession Session

@if (Session.Before.Items.Count == 0)
{
    <section class="clean">
        <h1>No CESC findings</h1>
        <p>This dump does not trip CESC-1 through CESC-6.</p>
    </section>
}
else
{
    <section class="splash">
        <div class="mega critical">
            <strong>@Session.Before.Summary.Critical</strong>
            <span>⚠ Critical</span>
        </div>
        <div class="splash-copy">
            <p class="eyebrow">@(Takeover is null ? "Scan" : "Full tenant takeover")</p>
            <h1>@(Takeover?.Title ?? "CESC findings")</h1>
            <div class="side-counts">
                <div class="pill high"><b>@Session.Before.Summary.High</b><span>High</span></div>
                <div class="pill medium"><b>@Session.Before.Summary.Medium</b><span>Medium</span></div>
            </div>
        </div>
    </section>

    <section class="picture">
        @foreach (var finding in Causes)
        {
            <article class="shot @finding.Severity.ToLowerInvariant()" id="@finding.Id">
                <header>
                    <span class="glyph" aria-hidden="true">@((MarkupString)Glyph(finding.Id))</span>
                    <span class="mono">@finding.Id</span>
                </header>
                <h2>@ShortTitle(finding)</h2>
                @if (finding.Id == FindingIds.Cesc1)
                {
                    <div class="race-bars" aria-label="Priority race. Lower number wins.">
                        @foreach (var binding in (finding.Evidence.Bindings ?? []).OrderBy(item => item.Priority))
                        {
                            <div class="race-row">
                                <span class="mono">P@(binding.Priority)</span>
                                <div class="track"><span class="fill win" style="width:@BarWidth(binding.Priority)%"></span></div>
                                <span>@binding.X509CertificateField</span>
                            </div>
                        }
                        @if (finding.Evidence.BestHighAffinityPriority is int high)
                        {
                            <div class="race-row dim">
                                <span class="mono">P@(high)</span>
                                <div class="track"><span class="fill lose" style="width:@BarWidth(high)%"></span></div>
                                <span>Key id</span>
                            </div>
                        }
                    </div>
                    <p class="caption">Lower number wins. The name beats the key.</p>
                }
                else if (finding.Id == FindingIds.Cesc2)
                {
                    <div class="equals">
                        <span class="token cert">CERT</span>
                        <span class="eq">=</span>
                        <span class="token login">LOGIN</span>
                    </div>
                    <p class="caption mono">@(finding.Evidence.DefaultMode ?? "x509CertificateSingleFactor")</p>
                }
                else
                {
                    <div class="unlocked">NO GROUP SCOPE</div>
                    @if (finding.Evidence.Authorities is { Count: > 0 })
                    {
                        <p class="caption">@IssuerLabel(finding.Evidence.Authorities[0])</p>
                    }
                }
                <Fix Item="@finding" />
            </article>
        }
    </section>

    @if (Rest.Count > 0)
    {
        <section class="strips">
            @foreach (var finding in Rest)
            {
                <article class="strip @finding.Severity.ToLowerInvariant()" id="@finding.Id">
                    <span class="mono">@finding.Id</span>
                    <strong>@ShortTitle(finding)</strong>
                    @if (finding.Evidence.Profiles is { Count: > 0 })
                    {
                        <span class="caption">@finding.Evidence.Profiles.Count profile@(finding.Evidence.Profiles.Count == 1 ? "" : "s")</span>
                    }
                    <Fix Item="@finding" />
                </article>
            }
        </section>
    }
}

@code {
    private Finding? Takeover => Session.Before.Items.FirstOrDefault(item => item.Id == FindingIds.Takeover);

    private IEnumerable<Finding> Causes => new[] { FindingIds.Cesc1, FindingIds.Cesc2, FindingIds.Cesc3 }
        .Select(id => Session.Before.Items.FirstOrDefault(item => item.Id == id))
        .OfType<Finding>();

    private List<Finding> Rest => Session.Before.Items
        .Where(item => item.Id is not FindingIds.Takeover and not FindingIds.Cesc1 and not FindingIds.Cesc2 and not FindingIds.Cesc3)
        .ToList();

    private static int BarWidth(int priority) => Math.Clamp(126 - priority * 30, 16, 100);

    private static string ShortTitle(Finding finding) => finding.Id switch
    {
        FindingIds.Cesc1 => "Name beats key",
        FindingIds.Cesc2 => "Certificate is the login",
        FindingIds.Cesc3 => "CA is not scoped",
        FindingIds.Cesc4 => "Revocation is off",
        FindingIds.Cesc5 => "Spoofable Intune name",
        FindingIds.Cesc6 => "Certificate too widely usable",
        _ => finding.Title
    };

    private static string Glyph(string id) => id switch
    {
        FindingIds.Cesc1 => "<svg viewBox='0 0 32 32'><path d='M6 22h20M8 18l8-12 8 12' fill='none' stroke='currentColor' stroke-width='2'/></svg>",
        FindingIds.Cesc2 => "<svg viewBox='0 0 32 32'><rect x='8' y='4' width='16' height='24' rx='2' fill='none' stroke='currentColor' stroke-width='2'/><path d='M12 12h8M12 17h8M12 22h5' stroke='currentColor' stroke-width='2'/></svg>",
        _ => "<svg viewBox='0 0 32 32'><rect x='7' y='14' width='18' height='13' rx='2' fill='none' stroke='currentColor' stroke-width='2'/><path d='M11 14v-3a5 5 0 0 1 10 0' fill='none' stroke='currentColor' stroke-width='2'/></svg>"
    };

    private static string IssuerLabel(AuthorityEvidence authority)
    {
        var name = string.IsNullOrWhiteSpace(authority.Issuer)
            ? "Trusted CA, name not captured by this scan"
            : authority.Issuer;
        return (authority.IsPublic ? "Public" : "Non-public") + " · " + name;
    }
}
